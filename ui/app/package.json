{
  "name": "autotrade-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src .storybook tests",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "playwright test",
    "test:e2e:rqu-ui-11": "playwright test tests/rqu-ui-11.spec.ts --config playwright.rqu-ui-11.config.ts",
    "test:smoke": "npm run build && npm run test && npm run build-storybook && npm run test:e2e"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.7.0",
    "@faker-js/faker": "10.5.0",
    "@playwright/test": "1.62.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "oxlint": "1.75.0",
    "shadcn": "4.16.2",
    "storybook": "10.5.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0"
  }
}
