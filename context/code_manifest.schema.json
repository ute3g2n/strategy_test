{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ctxmap-code-manifest-v0.1",
  "title": "Context code manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_version", "observed_at", "status", "artifacts", "diagnostics", "coverage"],
  "properties": {
    "schema_version": {"const": "ctxmap-code-manifest-v0.1"},
    "generator_version": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string"},
    "status": {"enum": ["COMPLETE", "PARTIAL", "BLOCKED"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code_id", "kind", "status", "relative_path", "schema_version", "generator_version", "language", "parser", "extraction_status", "symbols", "imports", "exports", "public_candidates", "config", "diagnostics", "line_count", "byte_size"],
        "properties": {
          "code_id": {"type": "string", "pattern": "^code-"},
          "kind": {"enum": ["managed_source", "managed_config"]},
          "status": {"enum": ["active", "blocked"]},
          "relative_path": {"type": "string", "pattern": "^[^/].*"},
          "last_known_path": {"type": "string"},
          "rename_status": {"type": "string"},
          "source_hash": {"type": ["string", "null"], "description": "Historical field only; active runtime neither creates nor validates it."},
          "schema_version": {"const": "ctxmap-code-manifest-v0.1"},
          "generator_version": {"type": "string"},
          "language": {"type": "string"},
          "parser": {"type": "string"},
          "extraction_status": {"enum": ["COMPLETE", "PARTIAL", "BLOCKED"]},
          "symbols": {"type": "array", "items": {"type": "object"}},
          "imports": {"type": "array", "items": {"type": "object"}},
          "exports": {"type": "array", "items": {"type": "string"}},
          "public_candidates": {"type": "array", "items": {"type": "string"}},
          "config": {"type": "object"},
          "diagnostics": {"type": "array", "items": {"type": "object"}},
          "line_count": {"type": "integer", "minimum": 0},
          "byte_size": {"type": "integer", "minimum": 0}
        }
      }
    },
    "diagnostics": {"type": "array", "items": {"type": "object"}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered", "registered"],
      "properties": {
        "discovered": {"type": "integer", "minimum": 0},
        "registered": {"type": "integer", "minimum": 0}
      }
    }
  }
}
