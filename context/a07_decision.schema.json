{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ctxmap-a07-decision-v0.1",
  "title": "CTXMAP A07 strict document decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "action",
    "summary",
    "purpose",
    "triggers",
    "headings",
    "relations",
    "confidence",
    "reason",
    "receipt"
  ],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^art-[0-9a-f-]{36}$"},
    "action": {
      "type": "string",
      "enum": ["record_add", "record_update", "metadata_unchanged", "blocked"]
    },
    "summary": {"type": "string", "maxLength": 2000},
    "purpose": {"type": "string", "maxLength": 2000},
    "triggers": {"type": "array", "maxItems": 100},
    "headings": {"type": "array", "maxItems": 1000},
    "relations": {"type": "array", "maxItems": 100},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Historical field only; A07 is inactive for metadata maintenance."},
    "receipt": {"type": "object"}
  }
}
