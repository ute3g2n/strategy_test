{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ctxmap-manifest-schema-v0.1",
  "title": "CTXMAP artifact manifest implementation schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generator_version", "artifacts"],
  "properties": {
    "schema_version": {"const": "ctxmap-manifest-v0.1"},
    "generator_version": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "status", "relative_path", "schema_version", "generator_version", "first_seen_at", "updated_at", "title", "headings", "trace_ids", "local_links", "summary", "purpose", "triggers", "relation_ids", "line_count", "byte_size"],
        "properties": {
          "artifact_id": {"type": "string", "pattern": "^art-[0-9a-f-]{36}$"},
          "kind": {"const": "managed_document"},
          "status": {"enum": ["active", "deleted", "partial", "blocked", "pending"]},
          "relative_path": {"type": "string", "minLength": 1, "maxLength": 1024},
          "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$", "description": "Historical field only; active runtime neither creates nor validates it."},
          "schema_version": {"const": "ctxmap-manifest-v0.1"},
          "generator_version": {"type": "string", "minLength": 1},
          "first_seen_at": {"type": "string", "minLength": 1},
          "updated_at": {"type": "string", "minLength": 1},
          "title": {"type": "string", "maxLength": 500},
          "headings": {"type": "array"},
          "trace_ids": {"type": "array", "uniqueItems": true},
          "local_links": {"type": "array", "uniqueItems": true},
          "summary": {"type": "string", "maxLength": 2000},
          "purpose": {"type": "string", "maxLength": 1000},
          "triggers": {"type": "array", "maxItems": 30},
          "relation_ids": {"type": "array", "uniqueItems": true},
          "line_count": {"type": "integer", "minimum": 0},
          "byte_size": {"type": "integer", "minimum": 0},
          "deleted_at": {"type": ["string", "null"]},
          "last_known_path": {"type": ["string", "null"]}
        }
      }
    }
  }
}
